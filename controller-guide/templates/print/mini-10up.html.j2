{% extends "base.html.j2" %}
{% from "partials/cards.html.j2" import mini, toolbar %}
{% block head %}<style>@page { size: letter; margin: 0; }</style>{% endblock %}
{% block body_class %}print-doc sheet-doc{% endblock %}
{% block header %}{{ toolbar(root, "Ten 3.5 × 2 in labels per Letter page, in the standard business-card layout (Avery 8371 / 5371 and similar). Print at 100%.", '<label class="cutlines-toggle"><input type="checkbox" data-cutlines> Show cut lines</label>' | safe) }}{% endblock %}
{% block main %}
{% for group in active | batch(10) %}
<section class="print-sheet ten-up">
  {% for c in group %}<div class="cell">{{ mini(c, qr, built) }}</div>{% endfor %}
</section>
{% endfor %}
{% endblock %}
{% block footer %}{% endblock %}
