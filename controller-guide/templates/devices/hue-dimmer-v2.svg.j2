{{ k.badge(c, "b1", 95, 53, 7.5) }}{{ k.badge(c, "b2", 95, 84, 7.5) }}{{ k.badge(c, "b3", 95, 105, 7.5) }}{{ k.badge(c, "b4", 95, 139, 7.5) }}
</svg>
