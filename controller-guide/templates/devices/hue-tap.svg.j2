{#- Hue Tap (ZGPSWITCH), from the Zigbee2MQTT photo: round, the whole face
    is button 1 (one dot near the top); three small round buttons marked
    with 2 dots (left), 3 dots (bottom) and 4 dots (right). The Hue app
    numbers the buttons by their dots. -#}
{% import "devices/_kit.svg.j2" as k %}{{ k.svg_open(c, 160, 160) }}
<circle class="dev-line" cx="80" cy="80" r="70"/>
<circle class="dev-line thin" cx="80" cy="80" r="63"/>
{{ k.dots(1, 80, 38, r=1.3) }}
<circle class="dev-line" cx="44" cy="80" r="15"/><circle class="dev-line" cx="116" cy="80" r="15"/><circle class="dev-line" cx="80" cy="114" r="15"/>
{{ k.dots(2, 44, 80, gap=3.4, r=1.3) }}{{ k.dots(3, 80, 114, gap=3.4, r=1.3) }}{{ k.dots(4, 116, 80, gap=3.4, r=1.3) }}
{#- Badges sit beside each button so the printed dots stay visible. -#}
{{ k.badge(c, "b1", 80, 56, 8) }}{{ k.badge(c, "b2", 30, 62, 7) }}{{ k.badge(c, "b3", 102, 128, 7) }}{{ k.badge(c, "b4", 130, 62, 7) }}
</svg>
