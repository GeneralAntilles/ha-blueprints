{#- Window advisor decision ladder (2026-09-30; v2 2026-10-08: enthalpy gate,
    forecast used as a trend anchored on the station, outlook gate,
    good_until / opens_around). The source of the window-advisor.yaml
    blueprint's decision (copied in by climate/build-window-advisor.py); the
    blueprint's sensor publishes this output as its `trace`, which the Logic
    card draws, so the card can never disagree with the decision.

    decide() is pure: every input is passed in, which is what lets the replay
    test in logic-view/ feed it synthetic weather. It returns JSON:
      state    "Good" | first blocking reason | "Blind: ..."
      mode     "open" (strict; not yet good) | "stay" (relaxed; debounced good)
      decided  index of the gate that decided (-1 = Good or Blind)
      gates    every check in ladder order, evaluated even past the deciding
               one: q (question), fail (true/false/null = no data), reason,
               short (terse label for the card's "also blocking" list),
               v + unit (value), t (active threshold), t_alt (other mode's),
               cmp (">": fail when v > t), lo/hi (number-line range),
               vs/vs_label/rule/rule_alt for thresholds that move with indoors
      proj     corrected forecast: [{t, temp, dp, precip}], first point = now
               (station reading), then every forecast hour after now shifted
               by bias = station now − forecast interpolated to now
      trend    {temp_2h, dp_2h, bias_temp, bias_dp} (projected Δ over 2 h)
      good_until   while Good: first proj point breaking the stay thresholds
                   (none = nothing modeled before forecast_through)
      outlook_ok   next 2 h hold the stay thresholds (any mode; none = unknown)
      opens_around first future proj hour passing every open threshold (indoor
                   and hazards held as now), dry, with the next 2 h holding (none = not within 12 h, or Good)
    Indoor values are held at their current reading in every projection.
    Thresholds are [open, stay]; stay is looser so advice doesn't flap.

    2026-10-17: heat headroom. raw.heat (optional mapping from
    the heat-headroom fit: head = lowest thermostat reading minus its
    heat setpoint, proj = that an hour ahead at the measured cooling rate,
    rate, name, temp, set) adds the "heat" gate: close when the house will
    be within heat_stay (0.25 °F) of a heat setpoint within the hour. With it, cold
    outside no longer closes the windows: it only downgrades Good to
    "Crack them" (level 'crack', gate soft-fails), and the projection's
    stay checks stop counting cold. Without it, cold works as before.
    Top level gains level ('open' | 'crack' | 'closed' | 'blind').

    2026-10-18: cool headroom. raw.cool (same shape, against the cool
    setpoint: head = cool setpoint minus the highest thermostat reading,
    proj = that an hour ahead at the measured warming rate) adds the "cool"
    gate, checked once the windows are open: close when a thermostat will be
    within cool_stay of its cool setpoint within the hour and outside isn't
    cooler than inside by warm_open_margin (if it is, the open windows are
    what's cooling the house). With it, staying
    open no longer depends on outside being cooler than inside or carrying
    less total heat: the house may drift anywhere between the setpoints, so
    those two checks only soft-fail in stay mode (a note, the advice stays
    Good) and the stay projection stops counting them. Opening still needs
    both (the "good time to open" push means it will actually cool). -#}

{%- macro r(x) -%}{{ x | round(0) | int }}{%- endmacro -%}

{#- Display (2026-10-18, blueprint): decide() works in °F / mph / BTU/lb;
    c.disp 'C' shows temperatures in °C, c.wind names the gust unit shown
    ('mph' | 'km/h' | 'm/s'). T = absolute temperature with unit, D = a
    temperature difference (number only), W = gust with unit. -#}
{%- macro T(x, c) -%}
  {{- r((x - 32) / 1.8) ~ '°C' if c.disp == 'C' else r(x) ~ '°F' -}}
{%- endmacro -%}
{%- macro D(x, c) -%}
  {{- '%g' | format((x / 1.8) | round(1)) if c.disp == 'C' else '%g' | format(x) -}}
{%- endmacro -%}
{#- Enthalpy difference: BTU/lb, or kJ/kg (× 2.326) for °C. -#}
{%- macro E(x, c) -%}
  {{- '%g' | format((x * 2.326) | round(1)) if c.disp == 'C' else x -}}
{%- endmacro -%}
{%- macro W(x, c) -%}
  {{- r(x * {'mph': 1, 'km/h': 1.609344, 'm/s': 0.44704}.get(c.wind, 1)) ~ ' ' ~ c.wind -}}
{%- endmacro -%}

{#- Moist-air enthalpy, BTU per lb of dry air, from °F temperature and dew
    point (sea-level pressure; both sides of a comparison share the error). -#}
{%- macro enth(t, dp) -%}
  {%- set c = (dp - 32) * 5 / 9 -%}
  {%- set pv = 6.112 * e ** (17.67 * c / (c + 243.5)) -%}
  {%- set w = 0.622 * pv / (1013.25 - pv) -%}
  {{- 0.240 * t + w * (1061 + 0.444 * t) -}}
{%- endmacro -%}

{#- Forecast [temp, dp] at timestamp ts, linear between hourly points
    ([ts, temp, dp, precip, t]); before the first point uses the first,
    past the last holds it for an hour, otherwise none. -#}
{%- macro fc_at(pts, ts) -%}
  {%- set ns = namespace(a=none, b=none) -%}
  {%- for p in pts -%}
    {%- if p[0] <= ts -%}{%- set ns.a = p -%}
    {%- elif ns.b is none -%}{%- set ns.b = p -%}{%- endif -%}
  {%- endfor -%}
  {%- if ns.a is not none and ns.b is not none -%}
    {%- set f = (ts - ns.a[0]) / (ns.b[0] - ns.a[0]) -%}
    {{- [ns.a[1] + f * (ns.b[1] - ns.a[1]), ns.a[2] + f * (ns.b[2] - ns.a[2])] | to_json -}}
  {%- elif ns.a is not none and ts - ns.a[0] <= 3600 -%}{{- [ns.a[1], ns.a[2]] | to_json -}}
  {%- elif ns.b is not none and ns.a is none -%}{{- [ns.b[1], ns.b[2]] | to_json -}}
  {%- else -%}null{%- endif -%}
{%- endmacro -%}

{#- Rain intervals ([start_ts, precip or none, t], each the hour starting
    at t) overlapping [a, b): the amounts, how many are known and wet. -#}
{%- macro rain_in(rain, a, b) -%}
  {%- set ns = namespace(p=[], t=[]) -%}
  {%- for x in rain if x[0] + 3600 > a and x[0] < b -%}
    {%- set ns.p = ns.p + [x[1]] -%}{%- set ns.t = ns.t + [x[2]] -%}
  {%- endfor -%}
  {%- set known = ns.p | select('number') | list -%}
  {{- {'p': ns.p, 't': ns.t, 'n': ns.p | length, 'known': known | length,
       'wet': known | select('>', 0) | list | length} | to_json -}}
{%- endmacro -%}

{#- 'yes' when every interval overlapping [a, b) is known and dry. -#}
{%- macro rain_dry(rain, a, b) -%}
  {%- set w = rain_in(rain, a, b) | from_json -%}
  {{- 'yes' if w.n > 0 and w.known == w.n and w.wet == 0 else 'no' -}}
{%- endmacro -%}

{#- 'yes' when no point in pts ([{temp, dp}]) breaks a stay threshold. -#}
{%- macro holds(pts, h_in, c) -%}
  {%- set ns = namespace(ok=true) -%}
  {%- for q in pts if ns.ok and breaks_stay(q.temp, q.dp, h_in, c) != '' -%}{%- set ns.ok = false -%}{%- endfor -%}
  {{- 'yes' if ns.ok else 'no' -}}
{%- endmacro -%}

{#- First stay threshold a projected point breaks ('' = holds). Warm is
    "over 74" alone: the live stay rule is over max(inside + 1, 74), but
    opening cools the house, so holding today's inside temperature would be
    optimistic; 74 is where that rule ends up once the house has cooled. -#}
{%- macro breaks_stay(t, dp, h_in, c) -%}
  {%- if t < c.cold_stay and not c.cold_soft -%}too cold
  {%- elif t > c.warm_stay_floor and not c.warm_soft -%}too warm
  {%- elif dp > c.dp_stay -%}too humid
  {%- elif enth(t, dp) | float > h_in + c.enth_margin and not c.warm_soft -%}muggier than inside
  {%- endif -%}
{%- endmacro -%}

{#- Defaults for every threshold (°F, BTU/lb, mph, µg/m³, % RH, hours). -#}
{%- set DEFAULTS = {'warm_open_margin': 2, 'warm_stay_margin': 1, 'warm_stay_floor': 74,
     'cold_open': 55, 'cold_stay': 52, 'house_open': 68, 'house_stay': 66,
     'dp_open': 58, 'dp_stay': 60, 'enth_margin': 0.5, 'rh_open': 60, 'rh_stay': 65,
     'pm_open': 20, 'pm_stay': 35, 'gust': 25, 'gust_stay': 30, 'rain_win_open': 3, 'rain_win_stay': 2,
     'outlook_h': 2, 'heat_open': 2, 'heat_stay': 0.25, 'cool_stay': 0.25, 'disp': 'F', 'wind': 'mph'} -%}

{%- macro decide(raw, hours, fetched, now_ts, stay, raining_recently, cfg={}) -%}
  {%- set c = dict(DEFAULTS, **(cfg if cfg is mapping else {})) -%}
  {%- set fetched_ts = as_timestamp(fetched, none) if fetched else none -%}
  {#- Only the current and future hours count: during a fetch outage the
      cached list ages, and past dry hours must not hide upcoming rain. -#}
  {%- set ns_h = namespace(h=[]) -%}
  {%- if hours is list -%}
    {%- for h in hours if h is mapping and as_timestamp(h.t, 0) >= now_ts - 3600 -%}
      {%- set ns_h.h = ns_h.h + [h] -%}
    {%- endfor -%}
    {%- set hours = ns_h.h -%}
  {%- endif -%}
  {%- set age_min = ((now_ts - fetched_ts) / 60) if fetched_ts is number else 9999 -%}
  {%- set missing = raw.items() | rejectattr('0', 'in', ['heat', 'cool'])
       | rejectattr('1', 'is_number') | map(attribute='0') | list -%}
  {#- Heat headroom is optional: absent or unknown means the old cold rule. -#}
  {%- set heat = raw.heat if raw.heat is defined and raw.heat is mapping
       and raw.heat.get('head') is number and raw.heat.get('proj') is number else none -%}
  {%- set cool = raw.cool if raw.cool is defined and raw.cool is mapping
       and raw.cool.get('head') is number and raw.cool.get('proj') is number else none -%}
  {#- Warm / total heat only soft-fail while staying open with the cool
      setpoint watched. -#}
  {#- Comfort band: only while the windows are known to be open (cfg
      windows_open, from the toggle), not merely because the advice was
      good, so a closed house still gets its next "open" suggestion. -#}
  {%- set band = cool is not none and stay and c.get('windows_open') is true -%}
  {%- set warm_soft = band -%}
  {#- Outside cooler than the limiting zone by the opening margin: the
      windows are what cools it, so nearing the AC setpoint is no reason to
      close (cool.helps from the blueprint, per zone; else the house). -#}
  {%- set helps = (cool.helps is true) if cool is not none and cool.helps is defined
       else (raw.get('ot') is is_number and raw.get('it') is is_number
             and raw.ot | float <= raw.it | float - c.warm_open_margin) -%}
  {%- set c = dict(c, cold_soft=heat is not none, warm_soft=warm_soft) -%}
  {%- set stale = hours is not list or hours | length < 3 or age_min > 90 -%}
  {%- set i = 1 if stay else 0 -%}
  {%- set win = [c.rain_win_open, c.rain_win_stay][i] -%}
  {%- set oh = c.outlook_h * 3600 -%}
  {#- Rain, kept apart from the temperature points so an hour missing its
      dew point still counts. An hour missing its precip key becomes none
      (unknown), never Undefined; map(default=none) doesn't work: Jinja
      treats a None default as unset. -#}
  {%- set ns_r = namespace(r=[]) -%}
  {%- if hours is list -%}
    {%- for h in hours if as_timestamp(h.t, none) is number -%}
      {%- set ns_r.r = ns_r.r + [[as_timestamp(h.t), h.precip if h.precip is defined
           and h.precip is number else none, h.t]] -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set rain = ns_r.r -%}
  {#- Forecast gate: every interval overlapping the next win hours. -#}
  {%- set fw = rain_in(rain, now_ts, now_ts + 3600 * win) | from_json -%}
  {%- set soon_hours = fw.p -%}
  {%- set ot = raw.get('ot') | float if raw.get('ot') is is_number else none -%}
  {%- set odp = raw.get('odp') | float if raw.get('odp') is is_number else none -%}
  {%- set it = raw.get('it') | float if raw.get('it') is is_number else none -%}
  {%- set idp = raw.get('idp') | float if raw.get('idp') is is_number else none -%}
  {%- set irh = raw.get('irh') | float if raw.get('irh') is is_number else none -%}
  {%- set pm = raw.get('pm') | float if raw.get('pm') is is_number else none -%}
  {%- set rr = raw.get('rr') | float if raw.get('rr') is is_number else none -%}
  {%- set gust = raw.get('gust') | float if raw.get('gust') is is_number else none -%}
  {#- Optional sensors (blueprint): a key absent from raw = not configured;
      its check passes with a note instead of reading as "no data". -#}
  {%- set off = namespace(rr='rr' not in raw, gust='gust' not in raw, pm='pm' not in raw,
                          irh='irh' not in raw) -%}
  {%- set have = namespace(ot=ot is number, odp=odp is number, it=it is number,
                           idp=idp is number, irh=irh is number, pm=pm is number,
                           rr=rr is number, gust=gust is number) -%}
  {%- set gust_t = [c.gust, c.gust_stay][i] -%}
  {%- set heat_t = [c.heat_open, c.heat_stay] -%}
  {%- set warm_t = [it - c.warm_open_margin, [it + c.warm_stay_margin, c.warm_stay_floor] | max] if have.it else [none, none] -%}
  {%- set h_out = enth(ot, odp) | float if have.ot and have.odp else none -%}
  {%- set h_in = enth(it, idp) | float if have.it and have.idp else none -%}
  {%- set enth_t = [h_in - c.enth_margin, h_in + c.enth_margin] if h_in is number else [none, none] -%}

  {#- Projection: the forecast's shape, anchored on the station's reading. -#}
  {%- set ns_f = namespace(pts=[]) -%}
  {%- if hours is list -%}
    {%- for h in hours if h.temp is defined and h.dp is defined
         and h.temp is number and h.dp is number -%}
      {%- set ns_f.pts = ns_f.pts + [[as_timestamp(h.t, 0), h.temp, h.dp,
           h.precip if h.precip is defined and h.precip is number else none, h.t]] -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set pts = ns_f.pts -%}
  {%- set base = fc_at(pts, now_ts) | from_json if pts | length >= 2 else none -%}
  {#- The outlook needs real forecast coverage through now + 2 h. -#}
  {%- set can_proj = base is not none and have.ot and have.odp
       and pts[-1][0] >= now_ts + oh -%}
  {%- set bias = [ot - base[0], odp - base[1]] if can_proj else [none, none] -%}
  {#- Corrected point at ts; dew point can't exceed temperature. -#}
  {%- set ns_q = namespace(q1=none, q2=none, win=[], proj=[]) -%}
  {%- if can_proj -%}
    {%- for x in [1, 2] -%}
      {%- set f = fc_at(pts, now_ts + oh * x / 2) | from_json -%}
      {%- if f is not none -%}
        {%- set q = [f[0] + bias[0], [f[1] + bias[1], f[0] + bias[0]] | min] -%}
        {%- if x == 1 -%}{%- set ns_q.q1 = q -%}{%- else -%}{%- set ns_q.q2 = q -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set cur = pts | selectattr('0', 'le', now_ts) | list -%}
    {%- set ns_q.proj = [{'t': (now_ts | as_datetime).isoformat(), 'temp': ot, 'dp': odp,
         'precip': cur[-1][3] if cur | length > 0 else none}] -%}
    {#- Outlook window: forecast hours inside (now, now + 2 h] plus the
        interpolated +1 h / +2 h points; the projection is linear between
        hours, so these cover every value in the window. -#}
    {%- for p in pts if p[0] > now_ts and p[0] <= now_ts + oh -%}
      {%- set pt = p[1] + bias[0] -%}
      {%- set ns_q.win = ns_q.win + [[pt, [p[2] + bias[1], pt] | min]] -%}
    {%- endfor -%}
    {%- for p in pts if p[0] > now_ts -%}
      {%- set pt = (p[1] + bias[0]) | round(1) -%}
      {%- set ns_q.proj = ns_q.proj + [{'t': p[4], 'temp': pt,
           'dp': [(p[2] + bias[1]) | round(1), pt] | min, 'precip': p[3]}] -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set proj = ns_q.proj -%}
  {%- set q2 = ns_q.q2 -%}
  {%- set trend = {'temp_2h': (q2[0] - ot) | round(1) if q2 is not none else none,
                   'dp_2h': (q2[1] - odp) | round(1) if q2 is not none else none,
                   'hours': c.outlook_h,
                   'bias_temp': bias[0] | round(1) if can_proj else none,
                   'bias_dp': bias[1] | round(1) if can_proj else none} -%}

  {#- Outlook: will the next 2 h still pass the stay thresholds? Computed in
      both modes (outlook_ok gates the "open" push, which can also fire in
      stay mode), but it only blocks the advice in open mode; once open,
      good_until carries the heads-up. Indoor readings are held fixed, so
      this is a conditional estimate, not a guaranteed duration. -#}
  {%- set ns_o = namespace(why='', ok=can_proj and h_in is number
                           and ns_q.q1 is not none and ns_q.q2 is not none) -%}
  {%- set ow = rain_in(rain, now_ts, now_ts + oh) | from_json -%}
  {%- if ns_o.ok -%}
    {%- for q in [ns_q.q1] + ns_q.win + [ns_q.q2] -%}
      {%- set why = breaks_stay(q[0], q[1], h_in, c) -%}
      {%- if ns_o.why == '' and why != '' -%}{%- set ns_o.why = why -%}{%- endif -%}
    {%- endfor -%}
    {%- if ns_o.why == '' and ow.wet > 0 -%}{%- set ns_o.why = 'rain' -%}{%- endif -%}
  {%- endif -%}
  {%- set gates = [
    {'k': 'rain', 'short': 'Raining', 'q': 'Not raining', 'unit': 'in/h', 'v': rr, 't': 0, 't_alt': 0, 'cmp': '>',
     'lo': 0, 'hi': 0.3, 'extra': 'rained in last 30 min' if raining_recently else none,
     'fail': ((rr > 0) or raining_recently) if have.rr else (true if raining_recently else (false if off.rr else none)),
     'note': 'no rain-rate sensor' if off.rr else none,
     'reason': 'Raining'},
    {'k': 'gust', 'short': 'Too gusty', 'q': 'Calm enough', 'unit': 'mph', 'v': gust, 't': gust_t, 't_alt': [c.gust, c.gust_stay][1 - i], 'cmp': '>=',
     'lo': 0, 'hi': 40, 'fail': (gust >= gust_t) if have.gust else (false if off.gust else none),
     'note': 'no gust sensor' if off.gust else none,
     'reason': 'Too gusty (' ~ W(gust, c) ~ ' gusts)' if have.gust else ''},
    {'k': 'pm', 'short': 'Smoky or dusty', 'q': 'Clean air outside', 'unit': 'µg/m³ PM2.5', 'v': pm, 't': [c.pm_open, c.pm_stay][i], 't_alt': [c.pm_open, c.pm_stay][1 - i],
     'cmp': '>', 'lo': 0, 'hi': 60, 'fail': (pm > [c.pm_open, c.pm_stay][i]) if have.pm else (false if off.pm else none),
     'note': 'no PM2.5 sensor' if off.pm else none,
     'reason': 'Outdoor air is dusty or smoky (PM2.5 ' ~ r(pm) ~ ')' if have.pm else ''},
    {'k': 'forecast', 'short': 'Rain in the next ' ~ win ~ ' h', 'q': 'Dry next ' ~ win ~ ' hours', 'unit': 'wet hours', 'v': fw.wet,
     't': 0, 't_alt': 0, 'cmp': '>', 'lo': 0, 'hi': 3, 'hours': soon_hours, 'hour_t': fw.t,
     'fail': (fw.wet > 0) if not stale and fw.known > 0 else none, 'reason': 'Rain in the forecast'},
    {'k': 'warm', 'short': 'Too warm outside', 'q': 'Cooler outside', 'unit': '°F out', 'v': ot, 't': warm_t[i], 't_alt': warm_t[1 - i],
     'cmp': '>', 'lo': 40, 'hi': 100, 'vs': it, 'vs_label': 'inside',
     'rule': ['inside − ' ~ D(c.warm_open_margin, c) ~ '°', 'inside + ' ~ D(c.warm_stay_margin, c) ~ '°, over ' ~ T(c.warm_stay_floor, c)[:-1]][i],
     'rule_alt': ['inside − ' ~ D(c.warm_open_margin, c) ~ '°', 'inside + ' ~ D(c.warm_stay_margin, c) ~ '°, over ' ~ T(c.warm_stay_floor, c)[:-1]][1 - i],
     'fail': ((false if warm_soft else ot > warm_t[i])) if have.ot and have.it else none,
     'soft': warm_soft and have.ot and have.it and ot > warm_t[i], 'soft_label': 'room to spare',
     'note': 'while open, the AC check decides' if warm_soft else none,
     'reason': "Outside (" ~ T(ot, c) ~ ") isn't cooler than inside (" ~ T(it, c) ~ ")" if have.ot and have.it else ''},
    {'k': 'cold', 'short': 'Too cold outside', 'q': 'Not too cold', 'unit': '°F out', 'v': ot, 't': [c.cold_open, c.cold_stay][i], 't_alt': [c.cold_open, c.cold_stay][1 - i],
     'cmp': '<', 'lo': 40, 'hi': 100,
     'fail': (false if heat is not none else ot < [c.cold_open, c.cold_stay][i]) if have.ot else none,
     'soft': heat is not none and have.ot and ot < [c.cold_open, c.cold_stay][i], 'soft_label': 'crack only',
     'note': 'below this: crack them, the heat check decides closing' if heat is not none else none,
     'reason': 'Too cold outside (' ~ T(ot, c) ~ ')' if have.ot else ''},
    {'k': 'house', 'short': 'House already cool', 'q': 'House needs cooling', 'unit': '°F in', 'v': it, 't': [c.house_open, c.house_stay][i], 't_alt': [c.house_open, c.house_stay][1 - i],
     'cmp': '<', 'lo': 55, 'hi': 85, 'fail': (it < [c.house_open, c.house_stay][i]) if have.it else none,
     'reason': 'House is already cool (' ~ T(it, c) ~ ')' if have.it else ''},
    {'k': 'heat', 'short': 'Heat would kick in', 'q': 'Heat stays off', 'unit': '° over heat set',
     'v': heat.proj | round(1) if heat else none, 't': heat_t[i] if heat else none, 't_alt': heat_t[1 - i] if heat else none,
     'cmp': '<', 'lo': -1, 'hi': 6, 'vs': heat.head | round(1) if heat else none, 'vs_label': 'now',
     'note': none if heat else 'no thermostat in a heating mode',
     'extra': (('in 1 h at ' ~ ('%+.1f' | format(heat.rate | float(0) / (1.8 if c.disp == 'C' else 1))) ~ '°/h'
               ~ (' · ' ~ heat.name if heat.name is defined and heat.name else ''))) if heat else none,
     'fail': (heat.proj < heat_t[i]) if heat else false,
     'reason': ('Heat would kick in soon (' ~ heat.name ~ ' ' ~ ('%.1f' | format((heat.temp | float(0) - 32) / 1.8
               if c.disp == 'C' else heat.temp | float(0))) ~ '°, set to ' ~ T(heat.set | float(0), c)[:-1] ~ ')') if heat and heat.name is defined
               and heat.temp is defined and heat.set is defined else 'Heat would kick in soon'},
    {'k': 'cool', 'short': 'AC would kick in', 'q': 'AC stays off', 'unit': '° under cool set',
     'v': cool.proj | round(1) if cool else none, 't': c.cool_stay if band else none,
     't_alt': none, 'cmp': '<', 'lo': -1, 'hi': 6, 'vs': cool.head | round(1) if cool else none, 'vs_label': 'now',
     'note': ('no thermostat in a cooling mode' if not cool else ((('outside is cooler: open windows help' if helps else none))
              if band else 'checked once the windows are open')),
     'extra': (('in 1 h at ' ~ ('%+.1f' | format(cool.rate | float(0) / (1.8 if c.disp == 'C' else 1))) ~ '°/h'
               ~ (' · ' ~ cool.name if cool.name is defined and cool.name else ''))) if cool else none,
     'fail': (cool.proj < c.cool_stay and not helps) if band else false,
     'reason': ('AC would kick in soon (' ~ cool.name ~ ' ' ~ ('%.1f' | format((cool.temp | float(0) - 32) / 1.8
               if c.disp == 'C' else cool.temp | float(0))) ~ '°, set to ' ~ T(cool.set | float(0), c)[:-1] ~ ')') if cool and cool.name is defined
               and cool.temp is defined and cool.set is defined else 'AC would kick in soon'},
    {'k': 'humid', 'short': 'Too humid outside', 'q': 'Dry enough outside', 'unit': '°F dew pt out', 'v': odp, 't': [c.dp_open, c.dp_stay][i], 't_alt': [c.dp_open, c.dp_stay][1 - i],
     'cmp': '>', 'lo': 30, 'hi': 80, 'fail': (odp > [c.dp_open, c.dp_stay][i]) if have.odp else none,
     'reason': 'Too humid outside (dew point ' ~ T(odp, c) ~ ')' if have.odp else ''},
    {'k': 'enthalpy', 'short': ['Too little cooling benefit', 'Too much total heat'][i], 'q': 'Less total heat',
     'unit': 'BTU/lb out', 'v': h_out | round(1) if h_out is number else none,
     't': enth_t[i] | round(1) if h_in is number else none, 't_alt': enth_t[1 - i] | round(1) if h_in is number else none,
     'cmp': '>', 'lo': 20, 'hi': 40, 'vs': h_in | round(1) if h_in is number else none, 'vs_label': 'inside',
     'rule': ['inside − ' ~ E(c.enth_margin, c), 'inside + ' ~ E(c.enth_margin, c)][i], 'rule_alt': ['inside − ' ~ E(c.enth_margin, c), 'inside + ' ~ E(c.enth_margin, c)][1 - i],
     'fail': ((false if warm_soft else h_out > enth_t[i])) if h_out is number and h_in is number else none,
     'soft': warm_soft and h_out is number and h_in is number and h_out > enth_t[i], 'soft_label': 'room to spare',
     'note': 'while open, the AC check decides' if warm_soft else none,
     'reason': ['Outside air offers too little cooling benefit', 'Outside air has too much total heat'][i]},
    {'k': 'rh', 'short': 'Humid inside', 'q': 'Indoor humidity OK', 'unit': '% RH in', 'v': irh, 't': [c.rh_open, c.rh_stay][i], 't_alt': [c.rh_open, c.rh_stay][1 - i],
     'cmp': '>', 'lo': 30, 'hi': 90, 'fail': (irh > [c.rh_open, c.rh_stay][i]) if have.irh else (false if off.irh else none),
     'note': 'no indoor humidity sensor' if off.irh else none,
     'reason': 'Indoor humidity is high (' ~ r(irh) ~ '%)' if have.irh else ''},
    {'k': 'outlook', 'short': ('Won\'t last: ' ~ ns_o.why) if ns_o.why else 'Won\'t last ' ~ c.outlook_h ~ ' h',
     'q': 'Holds for the next ' ~ c.outlook_h ~ ' hours', 'unit': '', 'v': none, 't': none, 't_alt': none,
     'note': ('only blocks before opening' ~ (' · would fail: ' ~ ns_o.why if ns_o.why else '')) if stay
             else 'projected outside air vs the stay-open limits',
     'extra': ('next ' ~ c.outlook_h ~ ' h: outside ' ~ ('%+.0f' | format(trend.temp_2h / (1.8 if c.disp == 'C' else 1))) ~ '°, dew pt '
               ~ ('%+.0f' | format(trend.dp_2h / (1.8 if c.disp == 'C' else 1))) ~ '°') if trend.temp_2h is number else none,
     'fail': false if stay else ((ns_o.why != '') if ns_o.ok else none),
     'reason': "Won't last: " ~ ns_o.why ~ ' within ' ~ c.outlook_h ~ ' h' if ns_o.why else ''},
  ] -%}
  {%- set first = namespace(i=-1) -%}
  {%- for g in gates -%}
    {%- if first.i < 0 and g.fail -%}{%- set first.i = loop.index0 -%}{%- endif -%}
  {%- endfor -%}
  {%- if missing | length > 0 -%}
    {%- set state = 'Blind: no data from ' ~ missing | join(', ') -%}
    {%- set first.i = -1 -%}
  {%- elif stale -%}
    {%- set state = 'Blind: forecast is stale' -%}
    {%- set first.i = -1 -%}
  {%- elif not can_proj -%}
    {%- set state = 'Blind: forecast projection unavailable' -%}
    {%- set first.i = -1 -%}
  {%- elif fw.known == 0 -%}
    {%- set state = 'Blind: forecast has no rain data' -%}
    {%- set first.i = -1 -%}
  {%- elif first.i >= 0 -%}
    {%- set state = gates[first.i].reason -%}
  {%- elif gates | selectattr('k', 'eq', 'cold') | selectattr('soft') | list | length > 0 -%}
    {%- set state = 'Crack them: cool outside (' ~ T(ot, c) ~ ')' -%}
  {%- else -%}
    {%- set state = 'Good' -%}
  {%- endif -%}
  {%- set level = 'blind' if state.startswith('Blind') else ('closed' if first.i >= 0
       else ('crack' if state.startswith('Crack') else 'open')) -%}
  {#- good_until: while Good, the earliest of the first future projected
      hour that breaks the stay thresholds and the first wet interval
      starting after now. Never the synthetic "now" point, so it's an hour
      string and doesn't change on every render. -#}
  {%- set ns_u = namespace(ts=none, t=none) -%}
  {%- if state == 'Good' and h_in is number -%}
    {%- for q in proj[1:] if ns_u.t is none and breaks_stay(q.temp, q.dp, h_in, c) != '' -%}
      {%- set ns_u.t = q.t -%}{%- set ns_u.ts = as_timestamp(q.t) -%}
    {%- endfor -%}
    {%- for x in rain if x[0] > now_ts and x[1] is number and x[1] > 0
          and (ns_u.ts is none or x[0] < ns_u.ts) -%}
      {%- if loop.first -%}{%- set ns_u.t = x[2] -%}{%- set ns_u.ts = x[0] -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {#- opens_around: while blocked by something the weather could fix (not
      a live hazard, not Blind), the first future hour passing every open
      threshold (held-current indoor and PM against the open limits), with
      the next 3 h known dry and the two hours after it holding. -#}
  {%- set ns_a = namespace(t=none) -%}
  {%- set hazard_now = gates[:3] | selectattr('fail') | list | length > 0 -%}
  {%- if state != 'Good' and not state.startswith('Blind') and not hazard_now
        and have.it and (off.irh or have.irh) and (off.pm or have.pm) and h_in is number
        and it >= c.house_open and (off.irh or irh <= c.rh_open) and (off.pm or pm <= c.pm_open)
        and (heat is none or heat.proj >= c.heat_open) -%}
    {%- set fut = proj[1:] -%}
    {%- for q in fut -%}
      {%- set k = loop.index0 -%}
      {%- set nxt = fut[k + 1:k + 1 + c.outlook_h] -%}
      {%- if ns_a.t is none and nxt | length == c.outlook_h
            and as_timestamp(nxt[-1].t) - as_timestamp(q.t) <= c.outlook_h * 3600
            and q.temp <= it - c.warm_open_margin and q.temp >= c.cold_open and q.dp <= c.dp_open
            and enth(q.temp, q.dp) | float <= h_in - c.enth_margin
            and rain_dry(rain, as_timestamp(q.t), as_timestamp(q.t) + 3600 * c.rain_win_open) == 'yes'
            and nxt | selectattr('temp', 'number') | list | length == c.outlook_h
            and holds(nxt, h_in, c) == 'yes' -%}
        {%- set ns_a.t = q.t -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {#- open_ok: every check passes the strict opening limits right now (any
      mode), so the open push can't ride on stay hysteresis after a "Crack
      them" episode left the debounced good flag on. -#}
  {%- set fo = rain_in(rain, now_ts, now_ts + 3600 * c.rain_win_open) | from_json -%}
  {#- Opening is judged without the comfort band: re-check the outlook with
      warm / muggier counted. -#}
  {%- set ns_oo = namespace(why=ns_o.why) -%}
  {%- if warm_soft and ns_o.ok and ns_oo.why == '' -%}
    {%- set c_open = dict(c, warm_soft=false) -%}
    {%- for q in [ns_q.q1] + ns_q.win + [ns_q.q2] if ns_oo.why == '' -%}
      {%- set ns_oo.why = breaks_stay(q[0], q[1], h_in, c_open) -%}
    {%- endfor -%}
  {%- endif -%}
  {%- set open_ok = level != 'blind' and not gates[0].fail
       and (off.gust or (have.gust and gust < c.gust)) and (off.pm or (have.pm and pm <= c.pm_open))
       and fo.known > 0 and fo.wet == 0
       and ot <= warm_t[0] and ot >= c.cold_open and it >= c.house_open
       and (heat is none or heat.proj >= c.heat_open)
       and odp <= c.dp_open and h_out <= enth_t[0] and (off.irh or (have.irh and irh <= c.rh_open))
       and ns_o.ok and ns_oo.why == '' -%}
  {#- °C / other wind units: convert the trace's numbers for the card (the
      decision above is already made, in °F). -#}
  {%- set proj_out, indoor_out, trend_out = proj, {'temp': it, 'dp': idp}, trend -%}
  {%- if c.disp == 'C' or c.wind != 'mph' -%}
    {%- set wf = {'mph': 1, 'km/h': 1.609344, 'm/s': 0.44704}.get(c.wind, 1) -%}
    {%- set ns_c = namespace(gates=[], proj=[]) -%}
    {%- for g in gates -%}
      {%- set u = g.unit -%}
      {%- set fo = ([1 / 1.8, -32 / 1.8, '°C' ~ u[2:]] if c.disp == 'C' and u.startswith('°F')
           else ([1 / 1.8, 0, u] if c.disp == 'C' and u in ['° over heat set', '° under cool set']
           else ([2.326, -17.86, 'kJ/kg out'] if c.disp == 'C' and u == 'BTU/lb out'
           else ([wf, 0, c.wind] if u == 'mph' else none)))) -%}
      {%- if fo is none -%}
        {%- set ns_c.gates = ns_c.gates + [g] -%}
      {%- else -%}
        {%- set ns_g = namespace(g=dict(g, unit=fo[2])) -%}
        {%- for k in ['v', 't', 't_alt', 'lo', 'hi', 'vs'] if g.get(k) is number -%}
          {%- set ns_g.g = dict(ns_g.g, **{k: (g[k] * fo[0] + fo[1]) | round(1)}) -%}
        {%- endfor -%}
        {%- set ns_c.gates = ns_c.gates + [ns_g.g] -%}
      {%- endif -%}
    {%- endfor -%}
    {%- set gates = ns_c.gates -%}
    {%- if c.disp == 'C' -%}
      {%- for q in proj -%}
        {%- set ns_c.proj = ns_c.proj + [dict(q, temp=((q.temp - 32) / 1.8) | round(1),
             dp=((q.dp - 32) / 1.8) | round(1))] -%}
      {%- endfor -%}
      {%- set proj_out = ns_c.proj -%}
      {%- set indoor_out = {'temp': ((it - 32) / 1.8) | round(1) if have.it else none,
                            'dp': ((idp - 32) / 1.8) | round(1) if have.idp else none} -%}
      {%- set ns_t = namespace(t=trend) -%}
      {%- for k in ['temp_2h', 'dp_2h', 'bias_temp', 'bias_dp'] if trend[k] is number -%}
        {%- set ns_t.t = dict(ns_t.t, **{k: (trend[k] / 1.8) | round(1)}) -%}
      {%- endfor -%}
      {%- set trend_out = ns_t.t -%}
    {%- endif -%}
  {%- endif -%}
  {%- set crack = {'tone': 'crack', 'kicker': 'Keep them cracked',
       'terminal': 'Clear, but cool outside → “crack them”'} if level == 'crack' else {} -%}
  {{- dict(crack, **{'state': state, 'level': level, 'mode': ['open', 'stay'][i], 'decided': first.i,
       'forecast_age_min': age_min | round(0) | int, 'gates': gates,
       'units': c.disp, 'proj': proj_out, 'trend': trend_out, 'indoor': indoor_out, 'good_until': ns_u.t,
       'outlook_ok': (ns_o.why == '') if ns_o.ok and (ns_o.why != '' or ow.known == ow.n) else none,
       'forecast_through': proj[-1].t if proj | length > 1 else none,
       'opens_around': ns_a.t, 'open_ok': open_ok}) | to_json -}}
{%- endmacro -%}
