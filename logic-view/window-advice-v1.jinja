{#-INPUTS-#}
{% set stay = is_state('binary_sensor.window_weather_good', 'on') %}
{% set raining_recently = is_state('binary_sensor.rain_in_last_30_minutes', 'on') %}
{% set raw = {
     'ot': states('sensor.outdoor_temperature'),
     'odp': states('sensor.outdoor_dewpoint'),
     'it': states('sensor.indoor_temperature'),
     'idp': states('sensor.indoor_dew_point'),
     'irh': states('sensor.indoor_humidity'),
     'pm': states('sensor.airgradient_outdoor_pm2_5'),
     'rr': states('sensor.weather_station_rain_rate'),
     'gust': states('sensor.weather_station_wind_gust') } %}
{% set hours = state_attr('sensor.window_forecast', 'hours') %}
{% set fetched = state_attr('sensor.window_forecast', 'fetched_at') %}
{% set now_ts = as_timestamp(now()) %}
{#-END-#}
{% set fetched_ts = as_timestamp(fetched, none) if fetched else none %}
{#- Only the current and future hours count: during a fetch outage the
    cached list ages, and past dry hours must not hide upcoming rain. -#}
{% set ns_h = namespace(h=[]) %}
{% if hours is list %}
  {% for h in hours if h is mapping and as_timestamp(h.t, 0) >= now_ts - 3600 %}
    {% set ns_h.h = ns_h.h + [h] %}
  {% endfor %}
  {% set hours = ns_h.h %}
{% endif %}
{% set age_min = ((now_ts - fetched_ts) / 60) if fetched_ts is number else 9999 %}
{% set missing = raw.items() | rejectattr('1', 'is_number')
                 | map(attribute='0') | list %}
{% if missing | length > 0 %}
  Blind: no data from {{ missing | join(', ') }}
{% elif hours is not list or hours | length < 3 or age_min > 90 %}
  Blind: forecast is stale
{% else %}
  {% set ot = raw.ot | float %}{% set odp = raw.odp | float %}
  {% set it = raw.it | float %}{% set idp = raw.idp | float %}
  {% set irh = raw.irh | float %}{% set pm = raw.pm | float %}
  {% set rr = raw.rr | float %}{% set gust = raw.gust | float %}
  {% set soon = hours[:(2 if stay else 3)] | map(attribute='precip')
                | select('number') | select('>', 0) | list %}
  {% if rr > 0 or raining_recently %}
    Raining
  {% elif gust >= 25 %}
    Too gusty ({{ gust | round(0) | int }} mph gusts)
  {% elif pm > (35 if stay else 20) %}
    Outdoor air is dusty or smoky (PM2.5 {{ pm | round(0) | int }})
  {% elif soon | length > 0 %}
    Rain in the forecast
  {% elif (stay and ot > it + 1 and ot > 74) or (not stay and ot > it - 2) %}
    Outside ({{ ot | round(0) | int }}°F) isn't cooler than inside ({{ it | round(0) | int }}°F)
  {% elif ot < (52 if stay else 55) %}
    Too cold outside ({{ ot | round(0) | int }}°F)
  {% elif it < (66 if stay else 68) %}
    House is already cool ({{ it | round(0) | int }}°F)
  {% elif odp > (60 if stay else 57) %}
    Too humid outside (dew point {{ odp | round(0) | int }}°F)
  {% elif odp > (idp + 1 if stay else idp - 1) %}
    Outside air is more humid than inside
  {% elif irh > (65 if stay else 60) %}
    Indoor humidity is high ({{ irh | round(0) | int }}%)
  {% else %}
    Good
  {% endif %}
{% endif %}